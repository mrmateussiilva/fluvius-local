    {
      "parameters": {
        "jsCode": "const env = typeof $env !== 'undefined' ? $env : (typeof process !== 'undefined' ? process.env : {});\nconst CHATWOOT_BASE_URL = env.CHATWOOT_BASE_URL || env.FLUVIUS_CHATWOOT_BASE_URL || 'https://fluvius.finderbit.com.br';\n\nconst body = $json.body || $json;\nconst event = String(body.event || '').trim();\nconst message = body.message || body;\nconst conversation = body.conversation || message.conversation || {};\nconst account = body.account || conversation.account || {};\nconst messageType = message.message_type ?? body.message_type;\nconst isIncoming = messageType === 'incoming' || messageType === 0 || messageType === '0';\nconst isPrivate = Boolean(message.private ?? body.private);\nconst content = String(message.content ?? body.content ?? '').trim();\nconst accountId = Number(account.id || conversation.account_id || body.account_id || body.account?.id || 0);\nconst conversationId = Number(conversation.id || body.conversation_id || message.conversation_id || 0);\nconst messageId = Number(message.id || body.id || 0);\n\nif (event !== 'message_created') {\n  return [{ json: { action: 'ignored', reason: `ignored_event:${event || 'unknown'}` } }];\n}\n\nif (!isIncoming || isPrivate || !content || !accountId || !conversationId || !messageId) {\n  return [{\n    json: {\n      action: 'ignored',\n      reason: 'not_public_incoming_message',\n      event,\n      messageType,\n      isPrivate,\n      accountId,\n      conversationId,\n      messageId,\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    action: 'process',\n    chatwootBaseUrl: CHATWOOT_BASE_URL.replace(/\\/$/, ''),\n    accountId,\n    conversationId,\n    messageId,\n    content,\n  },\n}];"
      },
