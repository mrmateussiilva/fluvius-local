    {
      "parameters": {
        "jsCode": "const input = $('Prepare Incoming').first().json;\nconst response = $json.payload || $json.data || $json;\nconst conversation = response.conversation || response;\nconst attrs = conversation.custom_attributes || {};\nconst currentLabels = Array.isArray(conversation.labels) ? conversation.labels : [];\nconst lastIncomingId = String(attrs.fluvius_triage_last_incoming_id || '');\n\nconst options = [\n  { key: '1', label: 'Comercial', slug: 'comercial' },\n  { key: '2', label: 'Financeiro', slug: 'financeiro' },\n  { key: '3', label: 'Suporte', slug: 'suporte' },\n];\nconst menu = [\n  'Olá! Para direcionar seu atendimento, escolha uma opção:',\n  '',\n  ...options.map(option => `${option.key} - ${option.label}`),\n  '',\n  'Digite apenas o número da opção desejada.',\n].join('\\n');\n\nconst base = {\n  chatwootBaseUrl: input.chatwootBaseUrl,\n  accountId: input.accountId,\n  conversationId: input.conversationId,\n  messageId: input.messageId,\n  content: input.content,\n};\n\nif (lastIncomingId === String(input.messageId)) {\n  return [{ json: { ...base, action: 'ignored', reason: 'duplicate_message' } }];\n}\n\nif (attrs.fluvius_triage_state === 'routed') {\n  return [{ json: { ...base, action: 'ignored', reason: 'already_routed' } }];\n}\n\nif (!attrs.fluvius_triage_state) {\n  return [{\n    json: {\n      ...base,\n      action: 'greet',\n      replyText: menu,\n      customAttributes: {\n        ...attrs,\n        fluvius_triage_state: 'waiting',\n        fluvius_triage_greeted_at: new Date().toISOString(),\n        fluvius_triage_last_incoming_id: String(input.messageId),\n      },\n    },\n  }];\n}\n\nconst choice = input.content.match(/^\\s*([1-3])\\s*$/)?.[1] || '';\nconst selected = options.find(option => option.key === choice);\n\nif (!selected) {\n  return [{\n    json: {\n      ...base,\n      action: 'invalid',\n      replyText: menu,\n      customAttributes: {\n        ...attrs,\n        fluvius_triage_state: 'waiting',\n        fluvius_triage_last_incoming_id: String(input.messageId),\n        fluvius_triage_last_invalid_at: new Date().toISOString(),\n      },\n    },\n  }];\n}\n\nconst label = `triagem-${selected.slug}`;\nconst labels = [...new Set([...currentLabels, label])];\nreturn [{\n  json: {\n    ...base,\n    action: 'route',\n    selectedOption: selected.key,\n    selectedLabel: selected.label,\n    triageLabel: label,\n    labels,\n    replyText: `Perfeito, vou direcionar seu atendimento para ${selected.label}.`,\n    customAttributes: {\n      ...attrs,\n      fluvius_triage_state: 'routed',\n      fluvius_triage_option: selected.key,\n      fluvius_triage_label: selected.label,\n      fluvius_triage_last_incoming_id: String(input.messageId),\n      fluvius_triage_routed_at: new Date().toISOString(),\n    },\n  },\n}];"
      },
